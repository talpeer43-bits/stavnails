@echo off
chcp 65001 > nul
title עדכון האתר באינטרנט
set "PATH=C:\Program Files\Git\cmd;%PATH%"
cd /d "%~dp0"

echo ===================================================
echo       💅 מעדכן את האתר החי באינטרנט (Render)...
echo ===================================================
echo.

git add .
git commit -m "עדכון אתר אוטומטי"
git push origin main

echo.
echo ===================================================
echo  ✅ השינויים נשלחו בהצלחה!
echo  האתר החי ב-Render מתעדכן עכשיו אוטומטית (תוך כדקה).
echo ===================================================
echo.
timeout /t 5